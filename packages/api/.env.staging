NODE_ENV=staging
PORT=3000

# Set via CI secrets — do not commit real values
DATABASE_URL=postgresql://bluecollar:CHANGE_ME@staging-db.internal:5432/bluecollar_staging
JWT_SECRET=CHANGE_ME
APP_URL=https://staging.bluecollar.app

# Email — use a sandbox provider in staging
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
FROM_EMAIL=noreply@staging.bluecollar.app

# Google OAuth — staging credentials
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Uploads
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE=5242880
